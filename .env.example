# Copy this file to .env and fill it in. .env is never committed to Git.

# --- Option A: your own OpenAI key (no university account needed) ---
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o

# --- Option B: Cornell AI Gateway or any OpenAI-compatible service ---
# OPENAI_API_KEY=your-gateway-key
# OPENAI_BASE_URL=https://your-gateway-url
# AGENT_MODEL=anthropic.claude-4.6-sonnet
# (Sandpiper-style AI_GATEWAY_KEY and AI_GATEWAY_BASE_URL also work.)

# --- Optional: a different model for some steps ---
# CODEBOOK_MODEL=    reading the codebook (a strong model helps)
# PROMPT_MODEL=      writing the prompt
# ANNOTATION_MODEL=  annotating utterances (most of the cost)
# SUGGESTION_MODEL=  suggesting prompt improvements
